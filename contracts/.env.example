# Red RPC de Arbitrum Sepolia (pública, sin secretos)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# CLAVE PRIVADA DEL DEPLOYER — SOLO PARA DEPLOY.
# NUNCA debe commitearse. Copia este archivo a `.env` y rellena el valor.
# Usa una wallet exclusiva para la hackathon con fondos mínimos de testnet,
# nunca una que almacene activos reales.
PRIVATE_KEY=

# Dirección pública del verificador que usará el panel admin (pública, sin secreto).
ADMIN_VERIFIER_ADDRESS=

# Clave de API de Etherscan (obligatoria para la verificación del contrato).
# Se crea en https://etherscan.io/apidashboard y sirve para todas las redes
# (API V2, `api.etherscan.io/v2/api?chainid=...`).
ETHERSCAN_API_KEY=