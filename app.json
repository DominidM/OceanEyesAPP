{
  "expo": {
    "name": "OceanEyes",
    "slug": "OceanEyes",
    "backgroundColor": "#0A0F1D",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "oceaneyes",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/favicon.png",
      "backgroundColor": "#0A0F1D",
      "supportsTablet": true,
      "bundleIdentifier": "com.belze.oceaneyesapp",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundImage": "./assets/images/favicon.png",
        "monochromeImage": "./assets/images/favicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.belze.oceaneyesapp",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OceanEyes necesita acceso a la cámara para tomar la foto del reporte."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F1D",
          "image": "./assets/images/favicon.png",
          "imageWidth": 120
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OceanEyes necesita acceso a tu ubicación para confirmar el lugar del reporte."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "OceanEyes necesita acceso al micrófono para grabar el audio del reporte."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "oceaneyes",
          "sounds": ["./assets/sounds/alarma_peligro.wav"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OceanEyes necesita acceso a tus fotos para adjuntarlas al reporte."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "OceanEyes necesita acceso a tu galería para mostrarte la última foto.",
          "savePhotosPermission": "OceanEyes necesita acceso para guardar fotos del reporte.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
